# Required database target: set DATABASE_URL, or select sqlite and set SQLITE_PATH.
DATABASE_PROVIDER=postgresql
DATABASE_URL=
SQLITE_PATH=
# Optional, separate loopback PostgreSQL target for pnpm verify:dual-db.
GEO_DUAL_DB_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional browser API CORS. Comma-separated exact origins, e.g. http://localhost:3001.
GEO_WEB_ALLOWED_ORIGINS=
# Enable only for cookie authentication from another site. Requires an HTTPS API URL.
GEO_WEB_CROSS_SITE_COOKIES=false
# Optional account mail gateway. The trusted ingress must overwrite the source-IP header.
GEO_AUTH_MAIL_URL=
GEO_AUTH_MAIL_SECRET=
GEO_AUTH_MAIL_IP_HEADER=
# Long-term development email mocks (always succeed without external mail gateway).
# Keep true in local development; set false only in production or strict security verification scripts.
GEO_AUTH_MAIL_MOCK=true
GEO_AUTH_EMAIL_VERIFIED_MOCK=true
# Local brand testing only. Use a dedicated test database and bind the app to loopback.
GEO_BRANDS_FIXTURE=
# Functional mock lane. Set to 1 in local dev to open labeled stand-in brand/workspace writes
# when the request host matches BETTER_AUTH_URL. Does not satisfy pilot admission.
# Leave empty when GEO_BRAND_DEV_INTAKE=true. Both switches together close brand writes.
GEO_FUNCTIONAL_MOCK=
# Development brand intake. Requires the exact database name, a host matching BETTER_AUTH_URL,
# and a comma-separated allowlist of account emails. This is not production pilot admission.
GEO_BRAND_DEV_INTAKE=
GEO_BRAND_DEV_INTAKE_DATABASE=
GEO_BRAND_DEV_INTAKE_ACTORS=
# Real brand intake stays closed unless each value is exactly true, GEO_BRAND_REAL_INTAKE=true,
# and GEO_AUTH_MAIL_URL plus GEO_AUTH_MAIL_SECRET name a non-mock gateway.
# Mail is long-term mocked in development (see AGENTS.md) and never blocks feature work.
GEO_PILOT_EMAIL_DELIVERY_VERIFIED=
GEO_PILOT_RECOVERY_VERIFIED=
GEO_PILOT_RETENTION_DISCLOSED=
GEO_PILOT_BACKUP_DRILL_VERIFIED=
GEO_PILOT_AUTHORIZED=
GEO_BRAND_REAL_INTAKE=
# AI Responses API configuration (server-only, put real values in gitignored .env.local).
# Run `pnpm env:check` to verify the development services, AI, and mock mail configuration.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
# Official sampling stays fail-closed until all four values are set on the server.
# In local dev, baseUrl/apiKey can reuse the OpenAI Responses API endpoint and key in .env.local.
GEO_OFFICIAL_SAMPLING_BASE_URL=
GEO_OFFICIAL_SAMPLING_API_KEY=
GEO_OFFICIAL_SAMPLING_PRODUCT_ENTRY=
GEO_OFFICIAL_SAMPLING_PRICE_TABLE=
GEO_OFFICIAL_SAMPLING_TIMEOUT_MS=
# Read-only public page checks stay closed unless this is exactly true. Never allow loopback from this flag.
GEO_PUBLIC_PAGE_FETCH=true
# Redis is required for the normal app entry points. Use memory in isolated tests only.
REDIS_URL=
GEO_CACHE_DRIVER=redis
# Required S3-compatible storage. Browser endpoint is needed for presigned downloads.
# Server-only. Never copy secrets into this file or NEXT_PUBLIC_*.
# Local SeaweedFS: S3_FORCE_PATH_STYLE=true and a loopback S3_ENDPOINT.
# Alibaba Cloud OSS: set the OSS S3 endpoint, region, bucket and keys, and S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=
S3_ENDPOINT_BROWSER=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
