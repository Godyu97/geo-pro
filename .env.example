DATABASE_URL=postgresql://geo:geo@127.0.0.1:55432/geo
# Explicit alternative: DATABASE_PROVIDER=sqlite with SQLITE_PATH pointing to a migrated file.
DATABASE_PROVIDER=postgresql
SQLITE_PATH=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional account mail gateway. The trusted ingress must overwrite the source-IP header.
GEO_AUTH_MAIL_URL=
GEO_AUTH_MAIL_SECRET=
GEO_AUTH_MAIL_IP_HEADER=
# Development-only email mocks. Keep unset or false in production.
GEO_AUTH_MAIL_MOCK=
GEO_AUTH_EMAIL_VERIFIED_MOCK=
# Local brand testing only. Use a dedicated test database and bind the app to loopback.
GEO_BRANDS_FIXTURE=
# Real brand intake stays closed unless each value is exactly true, GEO_BRAND_REAL_INTAKE=true,
# and GEO_AUTH_MAIL_URL plus GEO_AUTH_MAIL_SECRET name a non-mock gateway.
# GEO_AUTH_MAIL_MOCK=true never counts as delivery evidence. Leave these unset until that evidence exists.
GEO_PILOT_EMAIL_DELIVERY_VERIFIED=
GEO_PILOT_RECOVERY_VERIFIED=
GEO_PILOT_RETENTION_DISCLOSED=
GEO_PILOT_BACKUP_DRILL_VERIFIED=
GEO_PILOT_AUTHORIZED=
GEO_BRAND_REAL_INTAKE=
# AI Responses API configuration (server-only).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
# Official sampling stays fail-closed until all four values are set on the server.
GEO_OFFICIAL_SAMPLING_BASE_URL=
GEO_OFFICIAL_SAMPLING_API_KEY=
GEO_OFFICIAL_SAMPLING_PRODUCT_ENTRY=
GEO_OFFICIAL_SAMPLING_PRICE_TABLE=
GEO_OFFICIAL_SAMPLING_TIMEOUT_MS=
# Read-only public page checks stay closed unless this is exactly true. Never allow loopback from this flag.
GEO_PUBLIC_PAGE_FETCH=
# Cache. The default driver is redis. Set GEO_CACHE_DRIVER=memory only for an explicit single-process store.
# A missing or unreachable REDIS_URL falls back to the database and does not switch to memory.
REDIS_URL=
GEO_CACHE_DRIVER=
