{
  "name": "geo-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --conditions=react-server scripts/database.mjs generate",
    "db:migrate": "node --conditions=react-server scripts/database.mjs migrate",
    "db:ddl": "node scripts/export-ddl.mjs",
    "db:ddl:check": "node scripts/export-ddl.mjs --check",
    "db:auth-schema": "node --conditions=react-server scripts/database.mjs auth-schema",
    "verify:auth": "node --conditions=react-server scripts/verify-auth.mjs",
    "maintenance:access": "node --conditions=react-server scripts/maintenance-access.mjs",
    "test:maintenance": "node --conditions=react-server --test tests/maintenance/*.test.mjs",
    "test:brands": "node --conditions=react-server --test tests/brands/*.test.mjs",
    "test:data-exports": "node --conditions=react-server --test tests/data-exports/*.test.mjs",
    "verify:maintenance": "node --conditions=react-server scripts/verify-maintenance.mjs",
    "verify:brands": "node --conditions=react-server scripts/verify-brands.mjs",
    "brands:shorten-recovery": "node --conditions=react-server scripts/brand-deletion.mjs",
    "verify:data-exports": "node --conditions=react-server scripts/verify-data-exports.mjs",
    "test:quotas": "node --conditions=react-server --test tests/quotas/*.test.mjs",
    "verify:quotas": "node --conditions=react-server scripts/verify-quotas.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:i18n": "node --test tests/i18n/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@hookform/resolvers": "^7.0.6",
    "@next/env": "16.4.6",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "type": "module"
}
